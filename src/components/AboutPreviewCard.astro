---
import { getAge } from '../utils/date';

const age = getAge('2007-07-03');
---

<div
  class="mt-[20px] p-5 m-5 hover:shadow-[-3px_8px_10px_0_rgba(255,255,255,0.08),5px_-10px_10px_0_rgba(0,0,0,0.08)] shadow-[inset_-3px_8px_15px_0_rgba(255,255,255,0.1)] hover:scale-[100.5%] hover:-translate-y-[3px] duration-150 rounded-3xl"
>
  <a href="/about">
    <h2
      class="font-semibold xl:text-4xl md:text-3xl text-2xl text-start py-5 px-2 hover:underline"
    >
      About me
    </h2>
  </a>
  <div class="text-xl md:text-2xl xl:text-2xl px-4">
    <p>
      Hi 👋, my name is <b>Filip Řeháček</b>. Currently I'm {age} years
      old student of Computer Science on awesome prestigious high school{' '}
      <b>
        <a
          href="https://delta-skola.cz"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:underline"
          >Delta high school</a
        >
      </b>{' '}
      in <b>Pardubice, Czech Republic</b>.
    </p>
    <p class="mt-2">
      I like to learn new things in IT and with my skills I
      love to create applications and fun things that can help
      others and save them work.
    </p>
  </div>
  <a
    href="/about"
    class="text-right block text-lg md:text-xl p-3 group"
  >
    <span class="group-hover:underline">More</span> -&gt;
  </a>
</div>

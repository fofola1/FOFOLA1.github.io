---
import { Image } from 'astro:assets';
import linkedinImg from '../assets/img/linkedin.png';
import discordImg from '../assets/img/discord.png';
import instagramImg from '../assets/img/instagram.png';
import githubImg from '../assets/img/github.png';
import mailImg from '../assets/img/mail.png';
import { currentYear } from '../utils/date';
---

<footer
  class="bg-gradient-to-b to-bg1 from-transparent border-t-white border-t-[1px] mt-10 pt-10"
>
  <div
    class="flex justify-around items-start flex-wrap px-[calc(100%/2-730px)]"
  >
    <div class="pt-10">
      <h2>
        <a
          href="/contact"
          class="text-2xl md:text-3xl xl:text-3xl font-medium hover:underline pb-4"
          >Socials</a
        >
      </h2>
      <ul>
        <li
          class="text-xl px-2 md:text-2xl xl:text-2xl hover:underline py-1"
        >
          <Image
            alt="Linked in"
            src={linkedinImg}
            class="h-[25px] md:text-[29px] xl:text-[29px] w-auto inline-block pb-1 pr-[15px]"
            loading="eager"
          /><a
            target="_blank"
            rel="noopener noreferrer"
            href="https://www.linkedin.com/in/filip-rehacek"
            >Linked in</a
          >
        </li>
        <li
          class="text-xl px-2 md:text-2xl xl:text-2xl hover:underline py-1"
        >
          <Image
            alt="Discord"
            src={discordImg}
            class="h-[25px] md:text-[29px] xl:text-[29px] w-auto inline-block pb-1 pr-[15px]"
            loading="eager"
          /><a
            target="_blank"
            rel="noopener noreferrer"
            href="https://discordapp.com/users/1308882465821298861"
            >Discord</a
          >
        </li>
        <li
          class="text-xl px-2 md:text-2xl xl:text-2xl hover:underline py-1"
        >
          <Image
            alt="Instagram"
            src={instagramImg}
            class="h-[25px] md:text-[29px] xl:text-[29px] w-auto inline-block pb-1 pr-[15px]"
            loading="eager"
          /><a
            target="_blank"
            rel="noopener noreferrer"
            href="https://www.instagram.com/fl0x1c3k_"
            >Instagram</a
          >
        </li>
        <li
          class="text-xl px-2 md:text-2xl xl:text-2xl hover:underline py-1"
        >
          <Image
            alt="Github"
            src={githubImg}
            class="h-[25px] md:text-[29px] xl:text-[29px] w-auto inline-block pb-1 pr-[15px]"
            loading="eager"
          /><a
            target="_blank"
            rel="noopener noreferrer"
            href="https://github.com/FOFOLA1"
            >Github</a
          >
        </li>
        <li
          class="text-xl px-2 md:text-2xl xl:text-2xl hover:underline py-1 cursor-pointer"
        >
          <Image
            alt="E-mail"
            src={mailImg}
            class="h-[25px] md:text-[29px] xl:text-[29px] w-auto inline-block pb-1 pr-[15px]"
            loading="eager"
          /><a id="copy-email-footer" href="mailto:filip.rehacek@outlook.cz" class="copy-email-btn">E-mail</a>
        </li>
      </ul>
    </div>
    <div class="pt-10">
      <h2>
        <a
          href="/"
          class="text-2xl md:text-3xl xl:text-3xl font-medium hover:underline pb-4"
          >Filip Řeháček</a
        >
      </h2>
      <ul>
        <li
          class="py-1 px-3 hover:underline md:text-2xl xl:text-2xl text-xl"
        >
          <a href="/about">About me</a>
        </li>
        <li
          class="py-1 px-3 hover:underline md:text-2xl xl:text-2xl text-xl"
        >
          <a href="/projects">Projects</a>
        </li>
        <li
          class="py-1 px-3 hover:underline md:text-2xl xl:text-2xl text-xl"
        >
          <a href="/contact">Contact</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="p-3 mt-10">
    <p class="text-md md:text-xl xl:text-xl text-right">
      &copy; {currentYear}, Filip Řeháček. All rights reserved.
    </p>
  </div>
</footer>

<script>
  document.querySelectorAll('.copy-email-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      navigator.clipboard.writeText("filip.rehacek@outlook.cz").then(() => {
        alert('E-mail address copied to clipboard');
      }, () => {
        console.error('Failed to copy');
      });
    });
  });
</script>

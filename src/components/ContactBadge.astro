---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href?: string;
  iconSrc: ImageMetadata | string;
  alt: string;
  label: string;
  isCopyEmail?: boolean;
  imgPaddingClass?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  href,
  iconSrc,
  alt,
  label,
  isCopyEmail = false,
  imgPaddingClass = "pl-3",
  loading = "eager",
  fetchpriority = "high",
} = Astro.props;
---

{
  isCopyEmail ? (
    <a class="cursor-pointer copy-email-btn" href="mailto:filip.rehacek@outlook.cz">
      {typeof iconSrc === 'string' ? (
        <img src={iconSrc} alt={alt} class={imgPaddingClass} loading={loading} fetchpriority={fetchpriority} />
      ) : (
        <Image src={iconSrc} alt={alt} class={imgPaddingClass} loading={loading} fetchpriority={fetchpriority} />
      )}
      <span>{label}</span>
    </a>
  ) : (
    <a href={href} target="_blank" rel="noopener noreferrer">
      {typeof iconSrc === 'string' ? (
        <img src={iconSrc} alt={alt} class={imgPaddingClass} loading={loading} fetchpriority={fetchpriority} />
      ) : (
        <Image src={iconSrc} alt={alt} class={imgPaddingClass} loading={loading} fetchpriority={fetchpriority} />
      )}
      <span>{label}</span>
    </a>
  )
}
